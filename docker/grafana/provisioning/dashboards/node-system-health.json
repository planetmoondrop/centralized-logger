{
  "title": "Node.js System Health",
  "uid": "nodejs-system-health",
  "description": "Real-time Node.js process health: CPU, memory, heap, GC, event loop, and HTTP performance metrics via Prometheus.",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "tags": ["nodejs", "prometheus", "system", "health", "performance"],
  "editable": true,

  "templating": {
    "list": [
      {
        "name": "app",
        "label": "Service",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(http_requests_total, app)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".+",
        "multi": false,
        "sort": 1,
        "current": { "text": "All", "value": "$__all" },
        "hide": 0
      },
      {
        "name": "env",
        "label": "Environment",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(http_requests_total{app=~\"$app\"}, env)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".+",
        "multi": false,
        "sort": 1,
        "current": { "text": "All", "value": "$__all" },
        "hide": 0
      }
    ]
  },

  "panels": [

    {
      "id": 1,
      "type": "row",
      "title": "Overview",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },

    {
      "id": 2,
      "type": "stat",
      "title": "Request Rate",
      "description": "HTTP requests per second across all routes.",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 100 },
              { "color": "red", "value": 500 }
            ]
          }
        }
      },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "sum(rate(http_requests_total{app=~\"$app\",env=~\"$env\"}[$__rate_interval]))",
        "legendFormat": "req/s",
        "refId": "A"
      }]
    },

    {
      "id": 3,
      "type": "stat",
      "title": "Error Rate",
      "description": "HTTP 5xx server errors per second.",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.1 },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "sum(rate(http_requests_total{app=~\"$app\",env=~\"$env\",status_code=~\"5..\"}[$__rate_interval]))",
        "legendFormat": "errors/s",
        "refId": "A"
      }]
    },

    {
      "id": 4,
      "type": "stat",
      "title": "P95 Latency",
      "description": "95th percentile HTTP response time.",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "red", "value": 2 }
            ]
          }
        }
      },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "histogram_quantile(0.95, sum by(le) (rate(http_request_duration_seconds_bucket{app=~\"$app\",env=~\"$env\"}[$__rate_interval])))",
        "legendFormat": "p95",
        "refId": "A"
      }]
    },

    {
      "id": 5,
      "type": "stat",
      "title": "Heap Used",
      "description": "Current V8 heap memory in use.",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 400000000 },
              { "color": "red", "value": 800000000 }
            ]
          }
        }
      },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "sum(nodejs_heap_size_used_bytes{app=~\"$app\",env=~\"$env\"})",
        "legendFormat": "heap used",
        "refId": "A"
      }]
    },

    {
      "id": 6,
      "type": "stat",
      "title": "Event Loop Lag",
      "description": "Node.js event loop lag — high values mean the loop is blocked.",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.1 },
              { "color": "red", "value": 0.5 }
            ]
          }
        }
      },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "max(nodejs_eventloop_lag_seconds{app=~\"$app\",env=~\"$env\"})",
        "legendFormat": "lag",
        "refId": "A"
      }]
    },

    {
      "id": 7,
      "type": "stat",
      "title": "In-flight Requests",
      "description": "Number of HTTP requests currently being processed.",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 200 }
            ]
          }
        }
      },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "sum(http_requests_in_flight{app=~\"$app\",env=~\"$env\"})",
        "legendFormat": "in-flight",
        "refId": "A"
      }]
    },

    {
      "id": 10,
      "type": "row",
      "title": "CPU & Memory",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "collapsed": false
    },

    {
      "id": 11,
      "type": "timeseries",
      "title": "CPU Usage",
      "description": "Process CPU utilisation — user + system time.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 12, "gradientMode": "opacity" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.7 },
              { "color": "red", "value": 0.9 }
            ]
          }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "user" },
            "properties": [{ "id": "color", "value": { "fixedColor": "#5794F2", "mode": "fixed" } }]
          },
          { "matcher": { "id": "byName", "options": "system" },
            "properties": [{ "id": "color", "value": { "fixedColor": "#FF9830", "mode": "fixed" } }]
          }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by(app) (rate(process_cpu_seconds_total{app=~\"$app\",env=~\"$env\",type=\"user\"}[$__rate_interval]))",
          "legendFormat": "{{app}} user",
          "refId": "user"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by(app) (rate(process_cpu_seconds_total{app=~\"$app\",env=~\"$env\",type=\"system\"}[$__rate_interval]))",
          "legendFormat": "{{app}} system",
          "refId": "system"
        }
      ]
    },

    {
      "id": 12,
      "type": "timeseries",
      "title": "Memory — Heap, RSS, External",
      "description": "V8 heap used/total, process RSS, and external/ArrayBuffer memory.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 8, "gradientMode": "opacity" }
        }
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max", "lastNotNull"] }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by(app) (nodejs_heap_size_used_bytes{app=~\"$app\",env=~\"$env\"})",
          "legendFormat": "{{app}} heap used",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by(app) (nodejs_heap_size_total_bytes{app=~\"$app\",env=~\"$env\"})",
          "legendFormat": "{{app}} heap total",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by(app) (process_resident_memory_bytes{app=~\"$app\",env=~\"$env\"})",
          "legendFormat": "{{app}} RSS",
          "refId": "C"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by(app) (nodejs_external_memory_bytes{app=~\"$app\",env=~\"$env\"})",
          "legendFormat": "{{app}} external",
          "refId": "D"
        }
      ]
    },

    {
      "id": 13,
      "type": "gauge",
      "title": "Heap Utilisation %",
      "description": "Percentage of V8 heap currently in use. Above 85% risks OOM.",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "showThresholdLabels": true,
        "showThresholdMarkers": true,
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.7 },
              { "color": "orange", "value": 0.85 },
              { "color": "red", "value": 0.95 }
            ]
          }
        }
      },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "sum(nodejs_heap_size_used_bytes{app=~\"$app\",env=~\"$env\"}) / sum(nodejs_heap_size_total_bytes{app=~\"$app\",env=~\"$env\"})",
        "legendFormat": "heap %",
        "refId": "A"
      }]
    },

    {
      "id": 14,
      "type": "timeseries",
      "title": "GC Duration by Type",
      "description": "Time spent in V8 garbage collection per GC kind (minor, major, incremental).",
      "gridPos": { "h": 8, "w": 9, "x": 6, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 15 }
        }
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] }
      },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "sum by(app, gctype) (rate(nodejs_gc_duration_seconds_sum{app=~\"$app\",env=~\"$env\"}[$__rate_interval]))",
        "legendFormat": "{{app}} {{gctype}}",
        "refId": "A"
      }]
    },

    {
      "id": 15,
      "type": "timeseries",
      "title": "Event Loop Lag",
      "description": "Node.js event loop lag in seconds. Sustained values > 100ms indicate CPU-bound work blocking the loop.",
      "gridPos": { "h": 8, "w": 9, "x": 15, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 15 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.1 },
              { "color": "red", "value": 0.5 }
            ]
          }
        }
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "nodejs_eventloop_lag_seconds{app=~\"$app\",env=~\"$env\"}",
        "legendFormat": "{{app}}",
        "refId": "A"
      }]
    },

    {
      "id": 20,
      "type": "row",
      "title": "HTTP Performance",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 },
      "collapsed": false
    },

    {
      "id": 21,
      "type": "timeseries",
      "title": "Request Rate by Service",
      "description": "HTTP requests per second, broken down by service.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 23 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10, "gradientMode": "opacity" }
        }
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max", "lastNotNull"] }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by(app) (rate(http_requests_total{app=~\"$app\",env=~\"$env\"}[$__rate_interval]))",
          "legendFormat": "{{app}}",
          "refId": "A"
        }
      ]
    },

    {
      "id": 22,
      "type": "timeseries",
      "title": "Response Latency — p50 / p95 / p99",
      "description": "HTTP response time percentiles. p99 > 2s is a clear SLO breach.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 23 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 8 }
        },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": "p99.*" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } },
              { "id": "custom.lineWidth", "value": 3 }
            ]
          },
          { "matcher": { "id": "byRegexp", "options": "p95.*" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }
            ]
          }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.50, sum by(app, le) (rate(http_request_duration_seconds_bucket{app=~\"$app\",env=~\"$env\"}[$__rate_interval])))",
          "legendFormat": "{{app}} p50",
          "refId": "p50"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by(app, le) (rate(http_request_duration_seconds_bucket{app=~\"$app\",env=~\"$env\"}[$__rate_interval])))",
          "legendFormat": "{{app}} p95",
          "refId": "p95"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.99, sum by(app, le) (rate(http_request_duration_seconds_bucket{app=~\"$app\",env=~\"$env\"}[$__rate_interval])))",
          "legendFormat": "{{app}} p99",
          "refId": "p99"
        }
      ]
    },

    {
      "id": 23,
      "type": "timeseries",
      "title": "HTTP Status Codes Over Time",
      "description": "Request breakdown by HTTP status code family.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 31 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 20, "gradientMode": "opacity" }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "2xx" },
            "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }]
          },
          { "matcher": { "id": "byName", "options": "4xx" },
            "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }]
          },
          { "matcher": { "id": "byName", "options": "5xx" },
            "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }]
          }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(http_requests_total{app=~\"$app\",env=~\"$env\",status_code=~\"2..\"}[$__rate_interval]))",
          "legendFormat": "2xx",
          "refId": "2xx"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(http_requests_total{app=~\"$app\",env=~\"$env\",status_code=~\"4..\"}[$__rate_interval]))",
          "legendFormat": "4xx",
          "refId": "4xx"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(http_requests_total{app=~\"$app\",env=~\"$env\",status_code=~\"5..\"}[$__rate_interval]))",
          "legendFormat": "5xx",
          "refId": "5xx"
        }
      ]
    },

    {
      "id": 24,
      "type": "timeseries",
      "title": "Active Handles & Requests",
      "description": "Node.js libuv handles (sockets, timers, etc.) and active async requests.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 31 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max", "lastNotNull"] }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "nodejs_active_handles_total{app=~\"$app\",env=~\"$env\"}",
          "legendFormat": "{{app}} handles",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "nodejs_active_requests_total{app=~\"$app\",env=~\"$env\"}",
          "legendFormat": "{{app}} requests",
          "refId": "B"
        }
      ]
    },

    {
      "id": 30,
      "type": "row",
      "title": "Heap Detail",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 39 },
      "collapsed": false
    },

    {
      "id": 31,
      "type": "timeseries",
      "title": "V8 Heap Spaces",
      "description": "Memory breakdown by V8 heap space (new, old, code, map, large-object spaces).",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 40 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": { "lineWidth": 1, "fillOpacity": 8 }
        }
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "lastNotNull"] }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "nodejs_heap_space_size_used_bytes{app=~\"$app\",env=~\"$env\"}",
          "legendFormat": "{{app}} {{space_name}} used",
          "refId": "A"
        }
      ]
    }

  ]
}
