          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(count_over_time({app=~\"$services\"} | json | traceId = \"$traceId\" | __error__=\"\" [$__interval]))",
          "legendFormat": "log lines",
          "refId": "A"
        }
      ]
    },

