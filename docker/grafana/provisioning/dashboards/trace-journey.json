          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(count_over_time({app=~\"$services\"} | json | traceId = \"$traceId\" | __error__=\"\" | level = \"error\" [$__range]))",
          "instant": true,
          "refId": "A"
        }
      ]
