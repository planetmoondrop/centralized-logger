    {
      "id": 30,
      "type": "logs",
      "title": "Service hop timeline",
      "description": "HTTP ingress entry and response (http_in / http_in_res) per service, in time order: method, path, status, duration, spanId.",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 46 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Ascending",
        "dedupStrategy": "none"
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{app=~\"$services\"} | json | traceId = \"$traceId\" | __error__=\"\" | logType =~ \"http_in|http_in_res\" | line_format `[{{.service}}]  {{.method}}  {{.path}}  {{.statusCode}}  +{{.duration}}ms  span={{.spanId}}  traceId={{.traceId}}`",
          "refId": "A"
        }
      ]
    },

