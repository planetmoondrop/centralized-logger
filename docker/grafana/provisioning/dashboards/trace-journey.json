{
  "title": "Trace Journey Explorer",
  "uid": "trace-journey",
  "description": "Full cross-service trace journey. Paste a traceId to see the Tempo waterfall, every service hop, DB queries, outgoing calls, and all logs in chronological order. Also supports spanId drill-down.",
  "schemaVersion": 38,
  "version": 2,
  "refresh": false,
  "time": { "from": "now-30d", "to": "now" },
  "timepicker": { "hidden": true },
  "tags": ["nestjs", "loki", "tempo", "trace", "journey", "distributed"],
  "editable": true,

  "templating": {
    "list": [
      {
        "name": "traceId",
        "label": "Trace ID",
        "description": "Paste the x-loki-trace-id (32-char hex) returned in any API response header. Clicking 🔍 Open in Tempo on a log line auto-populates this.",
        "type": "textbox",
        "current": { "value": "" },
        "hide": 0
      },
      {
        "name": "spanId",
        "label": "Span ID (optional)",
        "description": "Paste a spanId to filter logs to a single span. Leave empty to show all spans.",
        "type": "textbox",
        "current": { "value": "" },
        "hide": 0
      },
      {
        "name": "services",
        "label": "Services",
        "description": "Regex of service names to include (leave .+ for all)",
        "type": "textbox",
        "current": { "value": ".+" },
        "hide": 0
      }
    ]
  },

  "panels": [

    {
      "id": 1,
      "type": "text",
      "title": "",
      "gridPos": { "h": 3, "w": 24, "x": 0, "y": 0 },
      "options": {
        "mode": "markdown",
        "content": "## How to use\n1. Every API response includes an **`x-loki-trace-id`** header (32-char hex). Copy that value.\n2. Paste it into **Trace ID** above and press Enter.\n3. If your services use `initObservability()`, the **Tempo Waterfall** panel renders the full span tree immediately.\n4. Scroll down for the **Loki log reconstruction** — service hop timeline, all log lines in sequence, DB queries, errors.\n5. **Span drill-down**: paste a `spanId` in the Span ID box to filter logs to that span only."
      },
      "transparent": true
    },

    {
      "id": 2,
      "type": "stat",
      "title": "Services Touched",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 3 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "reduceOptions": { "calcs": ["sum"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "#5794F2" },
          "unit": "short"
        }
      },
      "targets": [{
        "datasource": { "type": "loki", "uid": "loki" },
        "expr": "count(sum by(app) (count_over_time({app=~\"$services\"} | json | traceId = \"$traceId\" [30d])))",
        "instant": true,
        "refId": "A"
      }]
    },

    {
      "id": 3,
      "type": "stat",
      "title": "Total Log Lines",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 3 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "reduceOptions": { "calcs": ["sum"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "green" },
          "unit": "short"
        }
      },
      "targets": [{
        "datasource": { "type": "loki", "uid": "loki" },
        "expr": "sum(count_over_time({app=~\"$services\"} | json | traceId = \"$traceId\" [30d]))",
        "instant": true,
        "refId": "A"
      }]
    },

    {
      "id": 4,
      "type": "stat",
      "title": "Errors",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 3 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "reduceOptions": { "calcs": ["sum"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red",   "value": 1    }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "targets": [{
        "datasource": { "type": "loki", "uid": "loki" },
        "expr": "sum(count_over_time({app=~\"$services\"} | json | traceId = \"$traceId\" | level = \"error\" [30d]))",
        "instant": true,
        "refId": "A"
      }]
    },

    {
      "id": 5,
      "type": "stat",
      "title": "DB Queries",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 3 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "reduceOptions": { "calcs": ["sum"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "purple" },
          "unit": "short"
        }
      },
      "targets": [{
        "datasource": { "type": "loki", "uid": "loki" },
        "expr": "sum(count_over_time({app=~\"$services\"} | json | traceId = \"$traceId\" | logType = \"db\" [30d]))",
        "instant": true,
        "refId": "A"
      }]
    },

    {
      "id": 6,
      "type": "stat",
      "title": "Outgoing HTTP Calls",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 3 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "reduceOptions": { "calcs": ["sum"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "orange" },
          "unit": "short"
        }
      },
      "targets": [{
        "datasource": { "type": "loki", "uid": "loki" },
        "expr": "sum(count_over_time({app=~\"$services\"} | json | traceId = \"$traceId\" | logType = \"http_out\" [30d]))",
        "instant": true,
        "refId": "A"
      }]
    },

    {
      "id": 7,
      "type": "stat",
      "title": "Unique Spans",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 3 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "reduceOptions": { "calcs": ["sum"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "cyan" },
          "unit": "short"
        }
      },
      "targets": [{
        "datasource": { "type": "loki", "uid": "loki" },
        "expr": "count(sum by(spanId) (count_over_time({app=~\"$services\"} | json | traceId = \"$traceId\" [30d])))",
        "instant": true,
        "refId": "A"
      }]
    },

    {
      "id": 20,
      "type": "traces",
      "title": "Tempo Trace Waterfall",
      "description": "Full Jaeger-style span waterfall from Tempo. Requires initObservability() in your service. Click any span to jump to its Loki logs. If the panel is empty, your service has not been instrumented with OpenTelemetry yet — use the Loki panels below instead.",
      "gridPos": { "h": 22, "w": 24, "x": 0, "y": 7 },
      "datasource": { "type": "tempo", "uid": "tempo" },
      "options": {},
      "targets": [{
        "datasource": { "type": "tempo", "uid": "tempo" },
        "queryType": "traceId",
        "query": "$traceId",
        "refId": "A"
      }]
    },

    {
      "id": 30,
      "type": "logs",
      "title": "Service Hop Timeline  (http_in + http_in_res — entry and exit of each service)",
      "description": "All HTTP ingress log lines for this trace, in chronological order. Shows exactly which service was hit, in which order, with what method/path, and the response status+duration.",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 29 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": false,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Ascending",
        "dedupStrategy": "none"
      },
      "targets": [{
        "datasource": { "type": "loki", "uid": "loki" },
        "expr": "{app=~\"$services\"} | json | traceId = \"$traceId\" | logType =~ \"http_in|http_in_res\" | line_format `[{{.service}}]  {{.method}}  {{.path}}  {{.statusCode}}  +{{.duration}}ms  span={{.spanId}}  \"traceId\":\"{{.traceId}}\"`",
        "refId": "A"
      }]
    },

    {
      "id": 31,
      "type": "logs",
      "title": "Full Log Stream  (all lines, all services, in sequence order)",
      "description": "Every log line emitted during this trace, in strict chronological order. Expand any row to see all fields. TraceID and SpanID links open in Tempo. If Span ID filter is set, only that span's logs are shown.",
      "gridPos": { "h": 24, "w": 24, "x": 0, "y": 41 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Ascending",
        "dedupStrategy": "none"
      },
      "targets": [{
        "datasource": { "type": "loki", "uid": "loki" },
        "expr": "{app=~\"$services\"} | json | traceId = \"$traceId\"${__conditionalAll: | spanId = \"$spanId\",spanId}",
        "refId": "A"
      }]
    },

    {
      "id": 32,
      "type": "logs",
      "title": "DB Queries in this Trace",
      "description": "All database queries executed during this trace. Includes query text, duration (if TypeORM logger is enabled), and spanId for span-level correlation.",
      "gridPos": { "h": 12, "w": 12, "x": 0, "y": 65 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Ascending",
        "dedupStrategy": "none"
      },
      "targets": [{
        "datasource": { "type": "loki", "uid": "loki" },
        "expr": "{app=~\"$services\"} | json | traceId = \"$traceId\" | logType = \"db\"",
        "refId": "A"
      }]
    },

    {
      "id": 33,
      "type": "logs",
      "title": "Errors in this Trace",
      "description": "All log lines at level=error during this trace. Includes full stack traces when available.",
      "gridPos": { "h": 12, "w": 12, "x": 12, "y": 65 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Ascending",
        "dedupStrategy": "none"
      },
      "targets": [{
        "datasource": { "type": "loki", "uid": "loki" },
        "expr": "{app=~\"$services\"} | json | traceId = \"$traceId\" | level = \"error\"",
        "refId": "A"
      }]
    },

    {
      "id": 34,
      "type": "logs",
      "title": "Outgoing HTTP Calls in this Trace",
      "description": "All service-to-service HTTP calls made during this trace. Shows downstream URLs, methods, response codes, and durations.",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 77 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Ascending",
        "dedupStrategy": "none"
      },
      "targets": [{
        "datasource": { "type": "loki", "uid": "loki" },
        "expr": "{app=~\"$services\"} | json | traceId = \"$traceId\" | logType = \"http_out\"",
        "refId": "A"
      }]
    }

  ]
}
