# ══════════════════════════════════════════════════════════════════════════════
# Planetmoondrop Observability Stack — Environment Configuration
# ══════════════════════════════════════════════════════════════════════════════
#
# 1. Copy this file:   cp .env.example .env
# 2. Fill in values:   especially GRAFANA_ADMIN_PASSWORD
# 3. Start the stack:  docker compose up -d
#
# Lines starting with # are comments and are ignored.
# ══════════════════════════════════════════════════════════════════════════════


# ── Grafana ────────────────────────────────────────────────────────────────────
# Admin login for the Grafana UI (http://localhost:3000)
# ⚠️  CHANGE GRAFANA_ADMIN_PASSWORD before going to production.

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme


# ── Exposed Ports ─────────────────────────────────────────────────────────────
# Change these if any port conflicts with an existing service on your host.
# Internal container-to-container communication is NOT affected by these values.

GRAFANA_PORT=3000
LOKI_PORT=3100
PROMETHEUS_PORT=9090
TEMPO_HTTP_PORT=3200
TEMPO_OTLP_GRPC_PORT=4317    # OTLP gRPC  — your services send traces here
TEMPO_OTLP_HTTP_PORT=4318    # OTLP HTTP  — alternative trace ingestion endpoint

# ── Environment ───────────────────────────────────────────────────────────────
# Used as the `env` label on Prometheus scrape targets and Loki log streams.
# This value appears in all Grafana dashboards — set it to match your deployment.
# Examples: production  staging  development

ENVIRONMENT=production

# ── Prometheus ────────────────────────────────────────────────────────────────
# How long Prometheus keeps metrics on disk before discarding them.
# Examples: 15d  30d  90d

PROMETHEUS_RETENTION=30d


# ── Archive Exporter ──────────────────────────────────────────────────────────
# ARCHIVE_DIR  — path inside the container where .jsonl.gz files are written.
#                Mounted from ./archive/logs on the host — change the volume
#                bind in docker-compose.yml if you want a different host path.
# LOG_LIMIT    — max log lines fetched per sub-batch Loki query.
#                Raise if your log volume is very high; lower to reduce memory.

ARCHIVE_DIR=/archive
LOG_LIMIT=5000
