{
  "name": "moondrop-centralized-logger",
  "version": "1.1.0",
  "description": "Centralized Grafana Loki logging for NestJS microservices with distributed tracing, hierarchy, and zero-config setup.",
  "author": "Moondrop planetmoondrop@gmail.com",
  "license": "MIT",
  "homepage": "https://github.com/planet-moondrop/centralized-logger#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/planet-moondrop/centralized-logger.git"
  },
  "bugs": {
    "url": "https://github.com/planet-moondrop/centralized-logger/issues"
  },
  "keywords": [
    "nestjs",
    "loki",
    "grafana",
    "logging",
    "distributed-tracing",
    "microservices",
    "observability",
    "winston",
    "promtail",
    "trace-id",
    "centralized-logger",
    "centralized",
    "logger"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "moondrop": "bin/moondrop-init.mjs"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "build:watch": "tsup --watch",
    "lint": "eslint 'src/**/*.ts' 'test/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' 'test/**/*.ts' --fix",
    "format": "prettier --write 'src/**/*.ts' 'test/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' 'test/**/*.ts'",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.config.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run test && npm run build",
    "release": "standard-version",
    "release:minor": "standard-version --release-as minor",
    "release:major": "standard-version --release-as major"
  },
  "peerDependencies": {
    "@nestjs/common": "^9.0.0 || ^10.0.0",
    "@nestjs/core": "^9.0.0 || ^10.0.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.0.0",
    "typeorm": "^0.3.28",
    "@opentelemetry/sdk-node": ">=0.45.0",
    "@opentelemetry/exporter-trace-otlp-http": ">=0.45.0",
    "@opentelemetry/auto-instrumentations-node": ">=0.40.0",
    "@opentelemetry/resources": ">=1.0.0",
    "@opentelemetry/semantic-conventions": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/axios": {
      "optional": true
    },
    "typeorm": {
      "optional": true
    },
    "@opentelemetry/sdk-node": {
      "optional": true
    },
    "@opentelemetry/exporter-trace-otlp-http": {
      "optional": true
    },
    "@opentelemetry/auto-instrumentations-node": {
      "optional": true
    },
    "@opentelemetry/resources": {
      "optional": true
    },
    "@opentelemetry/semantic-conventions": {
      "optional": true
    }
  },
  "dependencies": {
    "@nestjs/axios": "^3.0.2",
    "@opentelemetry/api": "^1.9.1",
    "prom-client": "^15.1.3",
    "prompts": "^2.4.2",
    "uuid": "^9.0.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/testing": "^10.3.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.11.0",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "axios": "^1.6.5",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.2.4",
    "reflect-metadata": "^0.2.1",
    "resolve-from": "^5.0.0",
    "rxjs": "^7.8.1",
    "shx": "^0.4.0",
    "standard-version": "^9.5.0",
    "ts-jest": "^29.1.2",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/test/unit"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "src/**/*.(t|j)s",
      "!src/**/index.ts"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  }
}
